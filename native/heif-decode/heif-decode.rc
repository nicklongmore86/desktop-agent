// Version resource for heif-decode.exe. Keep FILEVERSION in sync with HEIF_DECODE_VERSION in
// scripts/job-helper.mjs.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "nicklongmore86"
      VALUE "FileDescription", "Desktop Agent HEIC photo decoder"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "heif-decode"
      VALUE "LegalCopyright", "Copyright (C) 2026 nicklongmore86"
      VALUE "OriginalFilename", "heif-decode.exe"
      VALUE "ProductName", "Desktop Agent"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
